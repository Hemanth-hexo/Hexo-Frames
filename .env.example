# Copy to .env.local for local dev (gitignored). In production these live
# in Netlify's dashboard: Site configuration -> Environment variables.

# --- Admin panel (/admin) ---------------------------------------------------
# Any password you choose — this gates the private photo-upload page.
ADMIN_PASSWORD=""
# Random string used to sign the admin session cookie, e.g. `openssl rand -hex 32`
SESSION_SECRET=""

# --- Photo uploads (commits straight to this GitHub repo) -------------------
# Fine-grained personal access token (github.com/settings/tokens) scoped to
# ONLY this repo, with "Contents" permission set to Read and write.
GITHUB_TOKEN=""
GITHUB_REPO="Hemanth-hexo/Hexo-Frames"
GITHUB_BRANCH="main"

# --- Contact form (sends email via your own Gmail account) -----------------
# Gmail account with 2-Step Verification enabled, then create an "App
# Password" at https://myaccount.google.com/apppasswords — not your real
# Gmail password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Where contact form submissions get sent — defaults to GMAIL_USER if unset.
CONTACT_TO_EMAIL=""
